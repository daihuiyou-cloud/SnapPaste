        <file alias="icons/edit.svg">../icons/edit.svg</file>
        <file alias="icons/close.svg">../icons/close.svg</file>
        <file alias="icons/rotate-left.svg">../icons/rotate-left.svg</file>
        <file alias="icons/rotate-right.svg">../icons/rotate-right.svg</file>
        <file alias="icons/flip-horizontal.svg">../icons/flip-horizontal.svg</file>
        <file alias="icons/flip-vertical.svg">../icons/flip-vertical.svg</file>
        <file alias="icons/opacity.svg">../icons/opacity.svg</file>
        <file alias="icons/click-through.svg">../icons/click-through.svg</file>
