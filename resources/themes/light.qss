QWidget {
    background: #f6f7f9;
    color: #20242a;
    font-size: 13px;
}

QMainWindow, QDialog {
    background: #f6f7f9;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #cfd6df;
    border-radius: 6px;
    padding: 7px 12px;
}

QPushButton#CaptureActionButton {
    background: #fbfdff;
    border: 1px solid #c7d2dd;
    border-radius: 7px;
    padding: 0;
}

QPushButton:hover {
    background: #eef4ff;
    border-color: #7aa7ff;
}

QPushButton:pressed {
    background: #dfeaff;
}

QLineEdit, QComboBox, QListView {
    background: #ffffff;
    border: 1px solid #cfd6df;
    border-radius: 5px;
    padding: 6px;
}

QToolBar {
    background: #ffffff;
    border-bottom: 1px solid #e1e5eb;
    spacing: 4px;
    padding: 4px 6px;
}

QToolBar::separator {
    height: 1px;
    background: #e1e5eb;
    margin: 4px 8px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}

QToolButton:hover {
    background: #eef4ff;
    border-color: #b8cffc;
}

QToolButton:pressed {
    background: #dfeaff;
}

QToolButton:checked {
    background: #e8f4f0;
    border-color: #2fbf9f;
}

QToolButton:hover:checked {
    background: #d6f0ea;
    border-color: #2fbf9f;
}

QToolButton#colorWell {
    border: 1px solid #d9dee7;
    border-radius: 4px;
    padding: 2px;
    min-width: 24px;
}

QToolButton#colorWell:hover {
    border-color: #b8cffc;
}

QWidget#CaptureActionBar {
    background: rgba(250, 253, 255, 238);
    border: 1px solid #aebdcb;
    border-radius: 8px;
}

QWidget#CaptureActionBar QPushButton#CaptureActionButton:hover {
    background: #e9f7f4;
    border-color: #2fbf9f;
}

QWidget#CaptureActionBar QPushButton#CaptureActionButton:pressed {
    background: #d6f0ea;
    border-color: #269d84;
}

QMenu {
    background: #ffffff;
    border: 1px solid #cfd6df;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px 6px 8px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #eef4ff;
    color: #172033;
}

QMenu::separator {
    height: 1px;
    background: #d9dee7;
    margin: 5px 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(160,160,160,0.35);
    min-height: 28px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: rgba(160,160,160,0.50); }
QScrollBar::handle:vertical:pressed { background: rgba(160,160,160,0.65); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    background: transparent;
    height: 7px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: rgba(160,160,160,0.35);
    min-width: 28px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: rgba(160,160,160,0.50); }
QScrollBar::handle:horizontal:pressed { background: rgba(160,160,160,0.65); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QScrollBar::corner { background: transparent; }
